<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }} | CreAid-Media Journal</title>
  <meta name="description" content="{{ description | escape }}">
  <meta name="robots" content="noindex,nofollow,noarchive">
  {% if canonical %}<link rel="canonical" href="{{ canonical | escape }}">{% endif %}
  <link rel="stylesheet" href="/assets/fonts.css">
  <link rel="stylesheet" href="/assets/journal.css">
  <link rel="stylesheet" href="/assets/journal-v9.css">
  <link rel="stylesheet" href="/assets/audit.css">
  <script defer src="/assets/audit-navigation.js"></script>
  <noscript><link rel="stylesheet" href="/assets/no-script.css"></noscript>
</head>
<body>
<a class="j-skip" href="#hauptinhalt">Zum Inhalt springen</a>
{% include "partials/header-journal.njk" %}
<main class="j-body" id="hauptinhalt"><article class="j-shell j-prose" style="padding-block:110px">{{ content | safe }}</article></main>
{% include "partials/footer-journal.njk" %}
<script src="/assets/journal.js" defer></script>
</body>
</html>
