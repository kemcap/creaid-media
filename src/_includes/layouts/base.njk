<!doctype html>
<html lang="de">
{% set meta = pages[pageKey] %}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {% if meta.themeColor %}<meta name="theme-color" content="{{ meta.themeColor | escape }}">{% endif %}
  <title>{{ meta.title | escape }}</title>
  <meta name="description" content="{{ meta.description | escape }}">
  <meta name="robots" content="{{ meta.robots or 'noindex,nofollow,noarchive' }}">
  <link rel="canonical" href="{{ meta.canonical | escape }}">
  <meta property="og:site_name" content="{{ site.name | escape }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:type" content="{{ meta.ogType | escape }}">
  <meta property="og:title" content="{{ meta.title | escape }}">
  <meta property="og:description" content="{{ meta.description | escape }}">
  <meta property="og:url" content="{{ meta.canonical | escape }}">
  <meta property="og:image" content="{{ meta.shareImage | escape }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/assets/fonts.css">
  <script defer src="/assets/adaptive-scroll.js"></script>
  {{ meta.extraHead | safe }}
  {% if meta.structuredData %}<script type="application/ld+json">{{ meta.structuredData | safe }}</script>{% endif %}
  <link rel="stylesheet" href="/assets/audit.css">
  <link rel="stylesheet" href="/assets/global-shell.css">
  <link rel="stylesheet" href="/assets/hero-balance.css">
  <link rel="stylesheet" href="/assets/ux-phase1.css">
  <link rel="stylesheet" href="/assets/content-phase3.css">
  <link rel="stylesheet" href="/assets/qa-phase4.css">
  <script defer src="/assets/audit-navigation.js"></script>
  <script defer src="/assets/global-shell.js"></script>
  <script defer src="/assets/service-crosshair.js"></script>
  <script defer src="/assets/ux-phase1.js"></script>
  <noscript><link rel="stylesheet" href="/assets/no-script.css"></noscript>
</head>
<body{{ meta.bodyAttrs | safe }}>
{{ content | safe }}
{% include "partials/footer-global.njk" %}
</body>
</html>
