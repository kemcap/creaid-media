<div class="cm-contactbar" id="cm-contactbar" role="navigation" aria-label="Schnellkontakt">
  <div class="cm-contactbar__inner">
    {% if site.social.linkedin %}<a class="cm-contactbar__link" href="{{ site.social.linkedin | escape }}" target="_blank" rel="noopener noreferrer" aria-label="CreAid-Media auf LinkedIn" title="LinkedIn"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7h.01M12 17v-7m0 3a3 3 0 0 1 6 0v4"/></svg><span>LinkedIn</span></a>{% endif %}
    {% if site.social.instagram %}<a class="cm-contactbar__link" href="{{ site.social.instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="CreAid-Media auf Instagram" title="Instagram"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg><span>Instagram</span></a>{% endif %}
    {% if site.social.facebook %}<a class="cm-contactbar__link" href="{{ site.social.facebook | escape }}" target="_blank" rel="noopener noreferrer" aria-label="CreAid-Media auf Facebook" title="Facebook"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3h-3a5 5 0 0 0-5 5v3H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 0 1 1-1h3z"/></svg><span>Facebook</span></a>{% endif %}
    <a class="cm-contactbar__link" href="mailto:{{ site.contact.email | escape }}" aria-label="E-Mail an {{ site.contact.email | escape }}" title="{{ site.contact.email | escape }}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>{{ site.contact.email | escape }}</span></a>
    {% if site.contact.whatsappUrl %}<a class="cm-contactbar__link" href="{{ site.contact.whatsappUrl | escape }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp – Chat öffnen" title="WhatsApp"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 3.5A11 11 0 0 0 3.2 16.4L2 22l5.8-1.3A11 11 0 0 0 20.5 3.5Z"/><path d="M8 7c-.7.2-1 1-1 1.8 0 3.3 4 7.2 7.4 7.2.8 0 1.5-.4 1.7-1l.4-1.2-2.9-1.4-.9 1a8.5 8.5 0 0 1-3.8-3.7l1-1-1.3-2.8Z"/></svg><span>WhatsApp</span></a>{% endif %}
    <a class="cm-contactbar__link cm-contactbar__phone" href="tel:{{ site.contact.phoneHref | escape }}" aria-label="Anrufen: {{ site.contact.phoneDisplay | escape }}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.9 19.9 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 2.1L7.7 10a16 16 0 0 0 6.3 6.3l1.2-1.3a2 2 0 0 1 2.1-.6l3 .5a2 2 0 0 1 1.7 2z"/></svg><span>{{ site.contact.phoneDisplay | escape }}</span></a>
  </div>
</div>
<header class="cm-header" id="cm-global-header">
  <div class="cm-header__inner">
    <a class="cm-header__brand" href="/" aria-label="CreAid-Media – zur Startseite">
      <img src="/assets/creaid-media-logo.webp" alt="CreAid-Media" width="9066" height="1000" decoding="async">
    </a>
    <button class="cm-header__toggle" id="cm-menu-toggle" type="button" aria-controls="cm-primary-nav" aria-expanded="false">
      <span class="cm-header__toggle-label">Menü</span>
      <span class="cm-header__toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <nav class="cm-header__nav" id="cm-primary-nav" aria-label="Hauptnavigation">
      <a class="cm-header__link" href="/"{% if pageKey == "index" %} aria-current="page"{% endif %}>Startseite</a>
      <details class="cm-header__services">
        <summary class="cm-header__link" aria-label="Leistungen und Leistungsbereiche">
          Leistungen <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="cm-header__dropdown">
          <div class="cm-header__dropdown-kicker">Kompetenzbereiche</div>
          {% for item in site.footerServices %}
          {% if item.href != "/kontakt" %}
          <a href="{{ item.href | escape }}"{% if item.pageKey == pageKey %} aria-current="page"{% endif %}>{{ item.label | escape }} <span aria-hidden="true">↗</span></a>
          {% endif %}
          {% endfor %}
          <div class="cm-header__dropdown-kicker cm-header__specialty-label">Spezialleistungen</div>
          <div class="cm-header__specialties">{% for item in site.specialtyServices %}<a href="{{ item.href | escape }}"{% if item.pageKey == pageKey %} aria-current="page"{% endif %}>{{ item.label | escape }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>
          <div class="cm-header__dropdown-kicker cm-header__specialty-label">Branchen</div>
          <div class="cm-header__branches">{% for item in site.branchServices %}<a href="{{ item.href | escape }}"{% if item.pageKey == pageKey %} aria-current="page"{% endif %}>{{ item.label | escape }} <span aria-hidden="true">↗</span></a>{% endfor %}</div>
          <a class="cm-header__dropdown-all" href="/leistungen">Alle Leistungen <span aria-hidden="true">→</span></a>
        </div>
      </details>
      <a class="cm-header__link" href="/referenzen"{% if pageKey == "referenzen" %} aria-current="page"{% endif %}>Referenzen</a>
      <a class="cm-header__link" href="/ueber-uns"{% if pageKey == "ueber-uns" %} aria-current="page"{% endif %}>Über uns</a>
      <a class="cm-header__link" href="/creaid-blog"{% if pageKey == "blog" %} aria-current="page"{% elif pages[pageKey].isPost or (pageKey | replace("archiv-", "")) != pageKey %} aria-current="location"{% endif %}>Journal</a>
      <a class="cm-header__link cm-header__contact-link" href="/kontakt"{% if pageKey == "kontakt" %} aria-current="page"{% endif %}>Kontakt</a>
    </nav>
  </div>
</header>
