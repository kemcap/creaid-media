<footer class="cm-footer" id="cm-global-footer">
  <div class="cm-footer__inner">
    <div class="cm-footer__lead">
      <div class="cm-footer__lead-copy">
        <span class="cm-footer__eyebrow"><span aria-hidden="true">+</span> Ihr nächstes Projekt</span>
        <h2>Ideen verdienen <em>Wirkung&#8288;<span class="cm-heading-dot" aria-hidden="true">.</span></em></h2>
        <p>Von der ersten Idee zum überzeugenden Auftritt.</p>
      </div>
      <a class="cm-footer__lead-cta" href="/kontakt">Projekt besprechen <span aria-hidden="true">↗</span></a>
    </div>
    <div class="cm-footer__grid">
      <div class="cm-footer__company">
        <a class="cm-footer__logo" href="/" aria-label="CreAid-Media – zur Startseite">
          <img src="/assets/creaid-media-logo.webp" width="9066" height="1000" alt="CreAid-Media" loading="lazy" decoding="async">
        </a>
        <p>Erste Hilfe für Ihre Marke.</p>
        <div class="cm-footer__social" aria-label="Social Media">
          {% if site.social.facebook %}<a href="{{ site.social.facebook | escape }}" rel="noopener noreferrer" target="_blank">Facebook ↗</a>{% endif %}
          {% if site.social.instagram %}<a href="{{ site.social.instagram | escape }}" rel="noopener noreferrer" target="_blank">Instagram ↗</a>{% endif %}
        {% if site.social.linkedin %}<a href="{{ site.social.linkedin | escape }}" rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>{% endif %}
        </div>
      </div>
      <section class="cm-footer__services audit-related" aria-labelledby="cm-footer-leistungen-heading">
        <div class="audit-inner">
          <h2 id="cm-footer-leistungen-heading">Leistungen im Überblick</h2>
          <ul class="audit-links">
            {% for item in site.footerServices %}
            <li><a href="{{ item.href | escape }}">{{ item.label | escape }} <span aria-hidden="true">↗</span></a></li>
            {% endfor %}
          </ul>
          <a class="cm-footer__all-services" href="/leistungen">Alle Leistungen ansehen <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="cm-footer__contact" aria-labelledby="cm-footer-contact-heading">
        <h2 id="cm-footer-contact-heading">Kontakt</h2>
        <a href="tel:{{ site.contact.phoneHref | escape }}">{{ site.contact.phoneDisplay | escape }}</a>
        <a href="mailto:{{ site.contact.email | escape }}">{{ site.contact.email | escape }}</a>
      </section>
      <nav class="cm-footer__legal" aria-label="Rechtliche Informationen">
        <h2>Informationen</h2>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/cookie-einstellungen">Cookie-Einstellungen</a>
        <a href="/ueber-uns">Über CreAid-Media</a>
      </nav>
    </div>
    <div class="cm-footer__bottom">
      <span>© 2026 CreAid-Media · Kreativität mit Wirkung</span>
      <span>Designvorschau · Nicht die veröffentlichte Unternehmenswebsite</span>
      <a href="#cm-global-header">Nach oben ↑</a>
    </div>
  </div>
</footer>
