{# Einmal im äußeren Layout eingefügt, nie innerhalb von Scroll-/Pin-Szenen. #}
<footer class="cm-site-footer" id="cm-footer">
  <div class="cm-footer-inner">
    <div class="cm-footer-intro">
      <div>
        <p class="cm-footer-kicker"><span aria-hidden="true">✳</span> CREAID-MEDIA / FIRST AID FOR YOUR BRAND</p>
        <h2>Gute Ideen.<br><em>Starke Wirkung.</em></h2>
