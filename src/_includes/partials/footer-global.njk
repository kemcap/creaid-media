        <ul class="cm-footer-links">
          {% for link in site.footerServiceLinks %}
          <li><a href="{{ link.href | escape }}">{{ link.label | escape }} <span aria-hidden="true">↗</span></a></li>
          {% endfor %}
        </ul>
      </nav>
      <div class="cm-footer-column cm-footer-contact">
        <h3>Kontakt</h3>
        <a href="tel:+4915678451152">+49 1567 8451152</a>
        <a href="mailto:info@creaid-media.de">info@creaid-media.de</a>
        <address>Yeniköy Mahallesi, 71. Sokak No: 19<br>07190 Döşemealtı / Antalya<br>Türkei</address>
      </div>
      <div class="cm-footer-column cm-footer-company">
