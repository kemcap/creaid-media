---
layout: layouts/base.njk
pageKey: leistungen
permalink: /leistungen.html
---
<a class="sp-skip" href="#hauptinhalt">Zum Inhalt springen</a>
{% include "partials/header-agency.njk" %}
<main id="hauptinhalt">
  <section class="service-content-hero">
    <div class="audit-inner">
      <h1>Leistungen von CreAid-Media</h1>
      <p>Wir gestalten Websites und Markenauftritte, verbessern die digitale Sichtbarkeit und erleichtern wiederkehrende Arbeitsabläufe.</p>
      <a class="a-btn" href="#alle-leistungen">Leistungen entdecken <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="audit-pillar" id="alle-leistungen" aria-labelledby="leistungen-title">
    <div class="audit-inner">
      <h2 id="leistungen-title">Was möchten Sie umsetzen?</h2>
      <div class="audit-grid">
        {% for group in serviceGroups %}
        {% set service = services[group] %}
        <article class="audit-panel">
          <h3><a href="{{ routes[group] }}">{{ service.label | escape }}</a></h3>
          <p>{{ pages[group].description | escape }}</p>
          {% include "partials/service-children.njk" %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  <section class="audit-related" id="direkt" aria-labelledby="leistungen-kontakt">
    <div class="audit-inner">
      <h2 id="leistungen-kontakt">Welches Angebot passt zu Ihrem Projekt?</h2>
      <p class="audit-lead">Beschreiben Sie kurz Ihr Ziel, Ihre Ausgangslage und die Aufgaben, für die Sie Unterstützung suchen.</p>
      <p><a class="a-btn" href="{{ routes.kontakt }}">Projekt besprechen <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>
  {% include "partials/editorial-links.njk" %}
</main>
{% include "partials/footer-agency.njk" %}
